{
  "name": "blackloud-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "lint:types": "oxlint --type-aware --max-warnings=0",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "rm -rf .next/types .next/dev/types && next typegen && tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tempus": "1.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.15.0"
}
